<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 检查更新后装新 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 只看导航/音乐这几个已知包名就够了，别为了列包申请 QUERY_ALL_PACKAGES -->
    <queries>
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.tencent.qqmusiccar" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.kugou.android.auto" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 车机不一定有触屏，但它是普通 Android 设备，不是 TV，别声明 leanback（否则 lint 要 LEANBACK_LAUNCHER） -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".LiteApp"
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarWithYou">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 车机桌面候选 -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StreamReceiverActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".ReceiverKeepService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".LyricOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".MusicListenerService"
            android:exported="true"
            android:label="CarWithYou歌词监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
